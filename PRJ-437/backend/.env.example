# Existing stack: FastAPI + PostgreSQL (SQLite fallback for offline demo).
DATABASE_URL=sqlite:///./dv_reports.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dv_reports

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_MINUTES=480

# Existing SafeReport AI provider: mock | llm
AI_PROVIDER=mock
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional Jev-first typed triage layer.
# Keep credentials only in local .env; never commit real keys.
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.70
JEV_SEVERITY_THRESHOLD=2.00
JEV_FLAG_PROB_THRESHOLD=0.70
