# Existing stack: FastAPI + PostgreSQL (SQLite fallback for offline demo).
# AI layer is additive only — set AI_PROVIDER=mock (default, no key needed) or llm.
DATABASE_URL=sqlite:///./dv_reports.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dv_reports

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_MINUTES=480

AI_PROVIDER=mock
# For AI_PROVIDER=llm (OpenAI-compatible endpoint). Never hardcode a key.
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
