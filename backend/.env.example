# Existing stack: FastAPI + PostgreSQL (SQLite fallback for offline demo).
# AI layer is additive only — AI_PROVIDER=jev (default, cloud, offline-safe) | mock | llm.

# ---- Runtime environment -------------------------------------------------
# development | demo | production
#   production refuses to boot with a dev JWT secret, demo seeding, an
#   enabled bootstrap-registration endpoint, or an empty CORS allowlist.
APP_ENV=development

DATABASE_URL=sqlite:///./dv_reports.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dv_reports

# ---- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_MINUTES=480

# Bootstrap the first administrator through POST /api/auth/register.
# Disabled by default. When enabled, BOOTSTRAP_ADMIN_TOKEN must be supplied
# with the request as "bootstrap_token".
ALLOW_BOOTSTRAP_ADMIN=0
# BOOTSTRAP_ADMIN_TOKEN=choose-a-long-random-value

# ---- Staff accounts ------------------------------------------------------
# SEED_STAFF=1 creates the admin/handler/viewer accounts on boot.
# The password comes from SEED_STAFF_PASSWORD; when that is unset a strong
# random password is generated and printed ONCE to the server console.
# SEED_STAFF=0
# SEED_STAFF_PASSWORD=
# Seed the canonical demo case SR-45012 (85/100 HIGH):
# SEED_DEMO=1

# ---- HTTP ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Empty (default) = same-origin only.
CORS_ORIGINS=
# Honour X-Forwarded-For for rate limiting. Enable ONLY behind a trusted
# reverse proxy, otherwise a client can spoof the header and evade limits.
TRUST_PROXY=0

# ---- Rate limits (per client IP unless noted) ----------------------------
RATE_LIMIT_REPORTS=10
RATE_LIMIT_LOGIN=10
RATE_LIMIT_TRACK=20
RATE_LIMIT_WINDOW_S=60

# ---- AI provider ---------------------------------------------------------
AI_PROVIDER=jev
# Live Jev (Replit Secrets — never commit a key):
#   TypeSafe early-access key (preferred): JEV_API_KEY=sk-...
#   Free mirror key (jev-agent.com/api-access): JEV_AGENT_KEY=jv_live_...
#   Explicit host override (else auto-selected by key prefix):
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest   # pin e.g. jev-1.13.0 in production
# For AI_PROVIDER=llm (OpenAI-compatible endpoint). Never hardcode a key.
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
